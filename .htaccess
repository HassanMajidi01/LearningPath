# فعال‌سازی rewrite
RewriteEngine On

# 1️⃣ ریدایرکت از HTTP به HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2️⃣ حذف www (انتقال به نسخه بدون www)
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# 3️⃣ ریدایرکت index.html به آدرس اصلی
RewriteCond %{THE_REQUEST} /index\.html [NC]
RewriteRule ^index\.html$ https://edu-kiashahr.ir/ [R=301,L]
